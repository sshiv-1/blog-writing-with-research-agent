# Groq API keys
GROQ_BLOG_API_KEY=gsk_your_blog_key_here
GROQ_PPTX_API_KEY=gsk_your_pptx_key_here

# Tavily web search
TAVILY_API_KEY=tvly-your_tavily_key_here

# Supabase persistence and auth (Optional: guests run in-memory)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional: if unset, tokens are verified via JWKS (RS256/ES256) at SUPABASE_URL
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Fernet symmetric encryption key for user BYOK storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=your_32_byte_base64_encryption_key_here

# Abuse controls and rate limits
GUEST_JOBS_PER_HOUR=20
DAILY_USER_JOB_CAP=50
MAX_CONCURRENT_USER_JOBS=3

# Reverse proxy support (set to true when deployed behind Render, Cloudflare, etc.)
# Extracts the client IP from the last entry of X-Forwarded-For for guest rate limiting
TRUST_PROXY=true

# Allowed CORS origins (comma-separated; localhost:5173 is always included by default)
CORS_ORIGINS=https://your-frontend.vercel.app
